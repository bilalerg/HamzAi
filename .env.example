# Profaix — örnek ayar dosyası
# Kopyala:  cp .env.example .env   (Windows: copy .env.example .env)
# Sonra aşağıdaki değerleri doldur. .env dosyası git'e GİTMEZ.

# ── ZORUNLU (lokal demo için bu üçü yeter) ─────────────────────────────
# Rastgele uzun değerler yaz. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=buraya-rastgele-uzun-bir-deger
ADMIN_TOKEN=buraya-baska-rastgele-bir-deger

# /login sayfasındaki yerel yönetici hesabı (ilk açılışta oluşturulur)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=profaix123

# ── MUHASEBE SAĞLAYICISI ───────────────────────────────────────────────
# yerel   → kayıtlar Profaix'in kendi veritabanında (Paraşüt gerekmez)
# parasut → Paraşüt API (aşağıdaki PARASUT_* alanları zorunlu olur)
MUHASEBE_SAGLAYICI=yerel

# Yerel modda ilk açılışta örnek cari/fatura/irsaliye yüklensin mi (1/0)
DEMO_VERI=1

# ── VERİTABANI (opsiyonel) ─────────────────────────────────────────────
# Boş bırakılırsa proje klasöründe profaix_yerel.db (SQLite) kullanılır.
# PostgreSQL için: postgresql://kullanici:sifre@localhost:5432/profaix
DATABASE_URL=

# ── CLAUDE (opsiyonel ama önerilir) ────────────────────────────────────
# Boşsa: sohbet basit anahtar-kelime moduna, fiş okuma elle girişe düşer.
ANTHROPIC_API_KEY=
# OCR_MODEL=claude-sonnet-4-6

# ── PARAŞÜT (sadece MUHASEBE_SAGLAYICI=parasut iken) ───────────────────
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
PARASUT_HURDA_PRODUCT_ID=

# Tenant Paraşüt şifrelerini veritabanında şifrelemek için (Fernet anahtarı)
CREDENTIAL_ENCRYPTION_KEY=

# ── CANLI ORTAM (lokalde gerekmez) ─────────────────────────────────────
ENV=development
# ALLOWED_ORIGINS=https://profaix.com
# BASE_URL=https://profaix-api.onrender.com
# PROFAIX_EMBED_SECRET=
# REQUIRE_SIGNED_EMBED_AUTH=0
